<!-- Config file for the engine -->
<config>
  <engine>
    <title>My platformer game</title>
    <maxFrameDuration value="16"/>
  </engine>

  <render>
    <vsync value="false"/>
  </render>

  <window>
    <resolution width="1280" height="720" scale="2"/>
    <fullscreen value="false"/>
    <borderless value="false"/>
    <resizable value="false"/>
    <fullscreen_window value="false"/>
  </window>
  <scene>
    <map path="Assets/Maps/" name="MapTemplate.tmx"/>
    <entities>
      <player x="32" y="156" w="48" h ="40" texture="Assets/Textures/player/Idle.png">
        <animations>
          <idle loop="true" speed ="0.18">
            <frame x="0" y="0" w="48" h="40"/>
            <frame x="48" y="0" w="48" h="40"/>
            <frame x="96" y="0" w="48" h="40"/>
            <frame x="144" y="0" w="48" h="40"/>
            <frame x="192" y="0" w="48" h="40"/>
            <frame x="240" y="0" w="48" h="40"/>
            <frame x="288" y="0" w="48" h="40"/>
            <frame x="336" y="0" w="48" h="40"/>
          </idle>
        </animations>
      </player>
    </entities>
  </scene>
	
</config>